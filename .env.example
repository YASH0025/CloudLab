# Neon Postgres connection string (Neon dashboard → Connect → copy the pooled URL).
# Leave unset in local development to use an in-memory store that resets on restart.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- Sign-in (optional). Each provider is enabled only when both of its values are set. ----
# A long random string (32+ characters). Required once any provider is enabled.
BETTER_AUTH_SECRET=""
# The site's public address. Not needed on Vercel (detected automatically).
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app: callback URL  <site>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth client (Web application): redirect URI  <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
